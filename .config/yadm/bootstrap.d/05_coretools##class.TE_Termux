#!/bin/bash
# vi:set ft=sh

set -eu

echo "[BOOTSTRAP] [05_coretools] Installing Termux core tools..."

pkg install -y \
    git git-lfs just ripgrep yadm vim zsh curl \
    tree fzf fd zoxide direnv

echo "[BOOTSTRAP] [05_coretools] Running git lfs install..."
git lfs install

echo "[BOOTSTRAP] [05_coretools] Core tool installation complete."
