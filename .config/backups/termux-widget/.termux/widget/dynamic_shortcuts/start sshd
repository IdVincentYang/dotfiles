#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

if pgrep -x sshd >/dev/null 2>&1; then
    printf '[sshd] already running\n'
    exit 0
fi

sshd
if pgrep -x sshd >/dev/null 2>&1; then
    printf '[sshd] started on port 8022\n'
else
    printf '[sshd] failed to start\n' >&2
    exit 1
fi
