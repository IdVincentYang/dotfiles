#!/data/data/com.termux/files/usr/bin/bash
# Termux:Widget shortcut for downloading video or audio from the clipboard.
set -Eeuo pipefail

VIDEO_DIR="$HOME/storage/movies"
AUDIO_DIR="$HOME/storage/music"

fail() {
    printf '[yt-dlp] %s\n' "$*" >&2
    exit 1
}

command -v termux-clipboard-get >/dev/null 2>&1 || fail 'termux-clipboard-get is missing; install the Termux:API app and the termux-api package.'
command -v yt-dlp >/dev/null 2>&1 || fail 'yt-dlp is missing; run: just install core-media-yt-dlp-termux'

if ! url="$(timeout 10 termux-clipboard-get | tr -d '\r' | sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}')"; then
    fail 'Unable to read the clipboard; install and open the Termux:API Android plugin.'
fi
[[ -n "$url" ]] || fail 'The clipboard is empty.'

case "$url" in
    http://*|https://*) ;;
    *) fail 'The clipboard does not contain an http(s) URL.' ;;
esac

printf '\n选择下载模式：\n'
printf '1) 单个视频\n'
printf '2) 视频播放列表\n'
printf '3) 单个音频\n'
printf '4) 音频播放列表\n'

while :; do
    IFS= read -r -p '请选择 [1-4]: ' download_mode || exit 0
    case "$download_mode" in
        1)
            DOWNLOAD_DIR="$VIDEO_DIR"
            PLAYLIST_OPTION=--no-playlist
            YTDLP_OUTPUT='%(title)s %(id)s.%(ext)s'
            MEDIA_TYPE=video
            break
            ;;
        2)
            DOWNLOAD_DIR="$VIDEO_DIR"
            PLAYLIST_OPTION=--yes-playlist
            YTDLP_OUTPUT='%(playlist_uploader&\[{playlist_uploader}]|)s%(playlist_uploader)s]%(playlist_title)s %(playlist_id)s/%(playlist_autonumber)02d %(title)s %(id)s.%(ext)s'
            MEDIA_TYPE=video
            break
            ;;
        3)
            DOWNLOAD_DIR="$AUDIO_DIR"
            PLAYLIST_OPTION=--no-playlist
            YTDLP_OUTPUT='%(title)s %(id)s.%(ext)s'
            MEDIA_TYPE=audio
            break
            ;;
        4)
            DOWNLOAD_DIR="$AUDIO_DIR"
            PLAYLIST_OPTION=--yes-playlist
            YTDLP_OUTPUT='%(playlist_uploader&[{playlist_uploader}]|)s%(playlist_title)s %(playlist_id)s/%(playlist_autonumber)02d %(title)s %(id)s.%(ext)s'
            MEDIA_TYPE=audio
            break
            ;;
        *)
            printf '无效选项，请输入 1 到 4。\n' >&2
            ;;
    esac
done

if [[ "$MEDIA_TYPE" == video ]]; then
    printf '\n选择视频分辨率上限：\n'
    printf '1) 不限（自动下载最高分辨率）\n'
    printf '2) 1080p\n'
    printf '3) 720p\n'
    printf '4) 480p\n'

    while :; do
        IFS= read -r -p '请选择 [1-4]: ' resolution_choice || exit 0
        case "$resolution_choice" in
            1)
                YTDLP_FORMAT='bv[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b'
                break
                ;;
            2) YDV_MAX_HEIGHT=1080 ;;
            3) YDV_MAX_HEIGHT=720 ;;
            4) YDV_MAX_HEIGHT=480 ;;
            *)
                printf '无效选项，请输入 1 到 4。\n' >&2
                continue
                ;;
        esac

        YTDLP_FORMAT="bv[ext=mp4][height<=${YDV_MAX_HEIGHT}]+ba[ext=m4a]/b[ext=mp4][height<=?${YDV_MAX_HEIGHT}]/bv*[height<=${YDV_MAX_HEIGHT}]+ba/b[height<=?${YDV_MAX_HEIGHT}]"
        break
    done

    YTDLP_ARGS=(
        --paths "$DOWNLOAD_DIR"
        "$PLAYLIST_OPTION"
        --console-title
        --format "$YTDLP_FORMAT"
        --sort 'vcodec:h265'
        --output "$YTDLP_OUTPUT"
    )
else
    YTDLP_ARGS=(
        --paths "$DOWNLOAD_DIR"
        "$PLAYLIST_OPTION"
        --console-title
        --no-embed-subs
        --format 'ba'
        --sort '+acodec:mp3,abr,asr'
        --output "$YTDLP_OUTPUT"
    )
fi

[[ -d "$DOWNLOAD_DIR" ]] || fail 'Shared storage is unavailable; run termux-setup-storage and grant file access.'
printf '[yt-dlp] downloading to %s\n' "$DOWNLOAD_DIR"
yt-dlp "${YTDLP_ARGS[@]}" "$url"
printf '[yt-dlp] download finished\n'
