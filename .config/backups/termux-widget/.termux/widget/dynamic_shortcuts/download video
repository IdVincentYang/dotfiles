#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

DOWNLOAD_DIR=/sdcard/Download/ytdl
YDV_RES=${MY_YDV_RES:-1080}
YDV_FORMAT="bv[ext=mp4][height<=${YDV_RES}]+ba[ext=m4a]/b[ext=mp4][height<=?${YDV_RES}]/bv*[height<=${YDV_RES}]+ba/b[height<=?${YDV_RES}]"

fail() {
    printf '[yt-dlp] %s\n' "$*" >&2
    exit 1
}

command -v termux-clipboard-get >/dev/null 2>&1 || fail 'termux-clipboard-get is missing; install the Termux:API app and the termux-api package.'
command -v yt-dlp >/dev/null 2>&1 || fail 'yt-dlp is missing; run: just install core-media-yt-dlp-termux'

if ! url="$(timeout 10 termux-clipboard-get | tr -d '\r' | sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}')"; then
    fail 'Unable to read the clipboard; install and open the Termux:API Android plugin.'
fi
[[ -n "$url" ]] || fail 'The clipboard is empty.'

case "$url" in
    http://*|https://*) ;;
    *) fail 'The clipboard does not contain an http(s) URL.' ;;
esac

mkdir -p "$DOWNLOAD_DIR"
printf '[yt-dlp] downloading to %s\n' "$DOWNLOAD_DIR"
yt-dlp \
    --paths "$DOWNLOAD_DIR" \
    --no-playlist \
    --console-title \
    --format "$YDV_FORMAT" \
    --sort 'vcodec:h265' \
    --output '%(title)s %(id)s.%(ext)s' \
    "$url"
printf '[yt-dlp] download finished\n'
