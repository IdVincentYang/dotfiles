#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

DOWNLOAD_DIR=/sdcard/Download/ytdl

fail() {
    printf '[yt-dlp] %s\n' "$*" >&2
    exit 1
}

command -v termux-clipboard-get >/dev/null 2>&1 || fail 'termux-clipboard-get is missing; install the Termux:API app and the termux-api package.'
command -v yt-dlp >/dev/null 2>&1 || fail 'yt-dlp is missing; run: just install core-media-yt-dlp-termux'

printf '\n选择视频分辨率上限：\n'
printf '1) 不限制（自动下载最高分辨率）\n'
printf '2) 1080p\n'
printf '3) 720p\n'
printf '4) 480p\n'

while :; do
    IFS= read -r -p '请选择 [1-4]: ' resolution_choice || exit 0
    case "$resolution_choice" in
        1)
            YDV_FORMAT='bv[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b'
            break
            ;;
        2) YDV_MAX_HEIGHT=1080 ;;
        3) YDV_MAX_HEIGHT=720 ;;
        4) YDV_MAX_HEIGHT=480 ;;
        *)
            printf '无效选项，请输入 1 到 4。\n' >&2
            continue
            ;;
    esac

    YDV_FORMAT="bv[ext=mp4][height<=${YDV_MAX_HEIGHT}]+ba[ext=m4a]/b[ext=mp4][height<=?${YDV_MAX_HEIGHT}]/bv*[height<=${YDV_MAX_HEIGHT}]+ba/b[height<=?${YDV_MAX_HEIGHT}]"
    break
done

if ! url="$(timeout 10 termux-clipboard-get | tr -d '\r' | sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}')"; then
    fail 'Unable to read the clipboard; install and open the Termux:API Android plugin.'
fi
[[ -n "$url" ]] || fail 'The clipboard is empty.'

case "$url" in
    http://*|https://*) ;;
    *) fail 'The clipboard does not contain an http(s) URL.' ;;
esac

mkdir -p "$DOWNLOAD_DIR"
printf '[yt-dlp] downloading to %s\n' "$DOWNLOAD_DIR"
yt-dlp \
    --paths "$DOWNLOAD_DIR" \
    --no-playlist \
    --console-title \
    --format "$YDV_FORMAT" \
    -S 'vcodec:h265' \
    --output '%(title)s %(id)s.%(ext)s' \
    "$url"
printf '[yt-dlp] download finished\n'
